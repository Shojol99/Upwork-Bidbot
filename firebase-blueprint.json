{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "training_data": {
      "title": "Training Data",
      "description": "Upwork job posts and successful cover letters",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "jobDescription": { "type": "string" },
        "coverLetter": { "type": "string" },
        "tags": { "type": "array" },
        "isWinning": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "jobDescription", "coverLetter"]
    },
    "generated_bid": {
      "title": "Generated Bid",
      "description": "Bids generated by the AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "jobDescription": { "type": "string" },
        "generatedContent": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "won", "lost"] },
        "score": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "generatedContent"]
    },
    "blocked_keyword": {
      "title": "Blocked Keyword",
      "description": "Keywords or phrases the AI should avoid",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "phrase": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "phrase"]
    },
    "ai_settings": {
      "title": "AI Settings",
      "description": "Custom personality settings for the AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tone": { "type": "string" },
        "length": { "type": "string" },
        "confidence": { "type": "string" },
        "ctaStyle": { "type": "string" },
        "greetingStyle": { "type": "string" },
        "technicalDepth": { "type": "string" },
        "persona": { "type": "string" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "users": {
      "schema": "user",
      "description": "Collection of user profiles"
    },
    "training_data": {
      "schema": "training_data",
      "description": "Collection of job-proposal pairs for RAG"
    },
    "generated_bids": {
      "schema": "generated_bid",
      "description": "History of AI-generated bids"
    },
    "blocked_keywords": {
      "schema": "blocked_keyword",
      "description": "User-specific blocked phrases"
    },
    "ai_settings": {
      "schema": "ai_settings",
      "description": "User configuration for generation parameters"
    }
  }
}
